# ── Base de datos ───────────────────────────────────────────────────────────
# Cadena de conexión de Postgres (Neon, Supabase o el proveedor que uses).
DATABASE_URL="postgresql://usuario:contrasena@host/basededatos?sslmode=require"

# ── Aplicación ──────────────────────────────────────────────────────────────
# URL pública del sitio. Stripe regresa aquí después del pago.
APP_URL="https://mirestaurantelisto.mx"
# Correo de la cuenta del dueño. Al registrarse con ese correo, la cuenta se
# crea con permiso de administrador y el servidor la manda al panel al entrar.
# Es la forma normal de acceder a /admin.
OWNER_EMAIL=""
# Respaldo de operación: permite llamar a la API de administración sin abrir
# sesión (scripts, respaldos). Invéntalo largo y privado.
ADMIN_TOKEN=""

# ── Cobro (Stripe) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
# Lo da Stripe al crear el webhook. Sin esto no se emite ninguna licencia.
# El webhook tiene que escuchar payment_intent.succeeded y charge.refunded.
STRIPE_WEBHOOK_SECRET=""
# Llave pública (pk_...). El cobro pasa dentro de nuestra pantalla con el
# Payment Element, y esta llave es la que monta ese formulario. Es pública por
# diseño: el servidor se la pasa a la pantalla de pago.
STRIPE_PUBLISHABLE_KEY=""

# ── Correo transaccional (opcional al arrancar) ─────────────────────────────
RESEND_API_KEY=""

# ── Medición (opcional al arrancar) ─────────────────────────────────────────
META_PIXEL_ID=""
META_CAPI_TOKEN=""
